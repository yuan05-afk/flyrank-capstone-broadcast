# Paste into Vercel Project Settings -> Environment Variables (Production + Preview).
# Replace placeholders after you create Neon and after the first deploy gives you a domain.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/broadcast?sslmode=require
NEXT_PUBLIC_APP_URL=https://broadcast-flyrank.vercel.app
DEMO_API_KEY=broadcast_demo_key_001
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
FAKE_PLATFORM_IN_APP=true
FAKE_PLATFORM_URL=
FAKE_PLATFORM_WEBHOOK_SECRET=broadcast_webhook_secret_prod_change_me
FAKE_PLATFORM_FORCE_429=false
APP_WEBHOOK_BASE_URL=https://broadcast-flyrank.vercel.app
