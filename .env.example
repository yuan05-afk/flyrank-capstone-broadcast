# Broadcast Studio environment
#
# Local: Neon free Postgres (recommended) or Docker Postgres.
# Vercel: import env.vercel.import, then set APP_WEBHOOK_BASE_URL / NEXT_PUBLIC_APP_URL
# to your deployed domain after the first deploy.

# Postgres (Neon / Vercel Postgres / local Docker). SQLite file URLs will not work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/broadcast?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_API_KEY="broadcast_demo_key_001"

# AES-256-GCM key (32 bytes as 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Local dual-process: leave FAKE_PLATFORM_URL pointing at port 4100 and run pnpm dev:fake.
# Vercel: leave FAKE_PLATFORM_URL empty (or set FAKE_PLATFORM_IN_APP=true) so the app
# uses /api/fake-platform on the same deployment.
FAKE_PLATFORM_URL="http://localhost:4100"
FAKE_PLATFORM_IN_APP="false"
FAKE_PLATFORM_WEBHOOK_SECRET="broadcast_webhook_secret_dev"
FAKE_PLATFORM_FORCE_429="false"

# Public base used by fake-platform webhooks back into this app
APP_WEBHOOK_BASE_URL="http://localhost:3000"

# Optional: override variant disk root (defaults to ./storage/variants locally, /tmp on Vercel)
# VARIANT_STORAGE_ROOT=""
